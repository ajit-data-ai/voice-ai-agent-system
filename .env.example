# ============================================================
# VOICE AI AGENT SYSTEM — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# ── SERVER ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=https://your-domain.com         # Your ngrok or production URL

# ── RETELL AI ────────────────────────────────────────────────
RETELL_API_KEY=your_retell_api_key
RETELL_AGENT_ID=your_agent_id           # Created via Retell dashboard
RETELL_WEBHOOK_SECRET=your_webhook_secret

# ── TWILIO ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX        # Your Twilio number (client's number)

# ── GOOGLE CALENDAR ──────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_refresh_token  # One-time OAuth setup
GOOGLE_CALENDAR_ID=primary               # Or specific calendar ID

# ── CLINIC CONFIGURATION ─────────────────────────────────────
CLINIC_NAME=Smile Perfect Dental
CLINIC_PHONE=+1XXXXXXXXXX               # Clinic's real phone (for transfers)
CLINIC_EMAIL=info@clinic.com
CLINIC_ADDRESS=123 Main St, City, State ZIP
CLINIC_TIMEZONE=America/New_York        # IANA timezone string
CLINIC_OPENING_HOUR=9                   # 24h format (9 = 9am)
CLINIC_CLOSING_HOUR=17                  # 24h format (17 = 5pm)
CLINIC_OPEN_DAYS=1,2,3,4,5             # Mon=1, Tue=2... Sun=7
APPOINTMENT_DURATION_MINUTES=60         # Default slot length
BOOKING_ADVANCE_HOURS=2                 # Minimum hours before appointment
BOOKING_MAX_DAYS_AHEAD=90               # How far ahead client can book

# ── NOTIFICATIONS ─────────────────────────────────────────────
STAFF_NOTIFICATION_EMAIL=staff@clinic.com
STAFF_NOTIFICATION_PHONE=+1XXXXXXXXXX   # Staff SMS for urgent calls
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# ── SECURITY ──────────────────────────────────────────────────
WEBHOOK_AUTH_TOKEN=your_secret_token    # Shared secret for webhook auth
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── LOGGING ───────────────────────────────────────────────────
LOG_LEVEL=info                          # error | warn | info | debug
LOG_TO_FILE=true
